`timescale 1ns / 1ps  // Time unit = 1ns, precision = 1ps

module tb_demux_1to8_4bit;

    // ?????????? ?????? ?? ???????
    reg [3:0] D;        // ?????? ???? (4 ????)
    reg [2:0] A;        // ??????? ????? (3 ????)
    wire [3:0] Q0, Q1, Q2, Q3, Q4, Q5, Q6, Q7;  // ?????? DEMUX

    // ??????????? ??????????? ?????? (UUT - Unit Under Test)
    demux_1to8_4bit uut (
        .D(D),
        .A(A),
        .Q0(Q0), .Q1(Q1), .Q2(Q2), .Q3(Q3),
        .Q4(Q4), .Q5(Q5), .Q6(Q6), .Q7(Q7)
    );

    // ????????? ???????? ????????
    initial begin
        // ?????????????
        D = 4'b0000;
        A = 3'b000;
        
        // ???? 1: A=000 ? Q0 = D
        D = 4'b1010; A = 3'b000; #10;  // ???????? 10 ??
        $display("Test 1: A=%b, Q0=%b (Expected: 1010)", A, Q0);
        
        // ???? 2: A=101 ? Q5 = D
        D = 4'b1100; A = 3'b101; #10;
        $display("Test 2: A=%b, Q5=%b (Expected: 1100)", A, Q5);
        
        // ???? 3: A=111 ? Q7 = D
        D = 4'b1111; A = 3'b111; #10;
        $display("Test 3: A=%b, Q7=%b (Expected: 1111)", A, Q7);
        
        // ?????????? ?????????
        $finish;
    end
endmodule